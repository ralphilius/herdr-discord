# Required: bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Optional: restrict the bridge to one guild (server). Empty = every guild the bot is in.
DISCORD_GUILD_ID=

# Optional: comma-separated Discord user IDs allowed to spawn/prompt agents.
# Empty = anyone who can post in a watched channel.
DISCORD_ALLOWED_USERS=

# Default agent kind for new threads. Any kind supported by `herdr agent start`:
# pi, claude, codex, gemini, cursor, devin, agy, cline, omp, mastracode,
# opencode, copilot, kimi, kiro, droid, amp, grok, hermes, kilo, qodercli,
# qwen, letta, maki, muse
HERDR_AGENT_KIND=claude

# Default working directory for workspaces/tabs created by the bridge.
# Per-channel overrides live in channels.json; a `cwd:` directive in the
# thread's first message overrides both. Empty = herdr's new-terminal cwd policy.
HERDR_WORKSPACE_CWD=

# Open the bot tab automatically when the Herdr server starts (startup hook).
DISCORD_AUTOSTART=0

# Post agent status transitions (blocked/done) into the Discord thread.
DISCORD_STATUS_POSTS=1

# Lines of agent output to post after done/blocked transitions.
DISCORD_OUTPUT_LINES=30

# How often to poll `herdr agent list` for status changes (ms).
DISCORD_POLL_MS=3000
